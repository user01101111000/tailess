# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
# `npm pack` writes here by default, and hand-verifying a release is the natural
# reason to run it — 400 kB of dist, one `git add -A` away from being in history.
*.tgz

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# Cache
.cache/
.turbo/

# Example apps resolve tailess by file:, so their lock churns on every version bump.
examples/*/package-lock.json
